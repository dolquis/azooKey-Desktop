# clangd configuration for azooKey-Desktop (Windows C++ / TSF TIP)
#
# Points clangd at the clang-cl compile database. Regenerate it with:
#   cmake -S . -B build/clangd -G Ninja \
#         -DCMAKE_CXX_COMPILER=clang-cl \
#         -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
#         -DAZOOKEY_BUILD_TESTS=OFF -DAZOOKEY_BUILD_BENCH=OFF
#
# clang-cl is used (not cl.exe) so clangd resolves the MSVC/Windows SDK system
# headers automatically without needing a --query-driver argument.
CompileFlags:
  CompilationDatabase: build/clangd
  # Serena/clangd-lsp may bundle clangd < 20, but a recent MSVC STL (14.5x)
  # static-asserts (STL1000) unless the compiler is Clang 20+. Skip that version
  # gate for IntelliSense only; the real cl.exe build is unaffected.
  # The -Wno-c++98-compat* flags drop spurious "incompatible with C++98" noise
  # (the project targets C++20; the compile DB carries -Wall -Wextra -Wpedantic).
  Add: [-D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH, -Wno-c++98-compat, -Wno-c++98-compat-pedantic, -Wno-pre-c++17-compat, -Wno-pre-c++20-compat]
