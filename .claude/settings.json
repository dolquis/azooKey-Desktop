{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(rg:*)",
      "Bash(python3 scripts/docs-lint.py:*)",
      "Bash(python3 scripts/check_agent_instruction_size.py:*)",
      "Bash(python3 scripts/check_test_inventory.py:*)",
      "Bash(python3 scripts/check_skill_references.py:*)",
      "Bash(python3 scripts/check_agent_definitions.py:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin dolquis/*)",
      "Bash(git push origin dolquis/*)",
      "Bash(cmake --preset:*)",
      "Bash(cmake --build --preset:*)",
      "Bash(ctest --preset:*)",
      "Bash(pre-commit run:*)",
      "Bash(python3 scripts/tests/test_git_push_guard.py)",
      "Bash(python3 scripts/tests/test_agent_instruction_size.py)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote get-url:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(python3 scripts/check_docs_impact.py:*)",
      "Bash(python3 scripts/check_doc_refs.py:*)",
      "Bash(python3 scripts/check_doc_contracts.py:*)",
      "Bash(python3 scripts/tests/test_check_agent_definitions.py)",
      "Bash(python3 scripts/tests/test_agent_readonly_guard.py)",
      "Bash(python3 scripts/tests/test_subagent_snapshot.py)",
      "Bash(python3 scripts/tests/test_check_test_inventory.py)",
      "Bash(python3 scripts/tests/test_check_skill_references.py)",
      "Bash(python3 scripts/tests/test_check_docs_impact.py)",
      "Bash(python3 scripts/tests/test_check_doc_refs.py)",
      "Bash(python3 scripts/tests/test_check_doc_contracts.py)",
      "Bash(uvx --from clang-format==18.1.8 git-clang-format --binary clang-format --diff:*)",
      "Bash(check-jsonschema:*)"
    ],
    "ask": [
      "Edit(legacy/**)"
    ],
    "deny": [
      "Edit(.env*)",
      "Edit(**/secrets/**)",
      "Edit(.serena/memories/**)",
      "Edit(.codegraph/**)",
      "Edit(.claude/settings.local.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then exec bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"; fi'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-push-guard.py",
            "timeout": 60,
            "statusMessage": "git-push-guard (push destination)"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "diff-auditor|spec-drift-checker|windows-build-runner|quality-gate-runner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-snapshot.py\"",
            "timeout": 30,
            "statusMessage": "subagent-snapshot (checkout snapshot)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "diff-auditor|spec-drift-checker|windows-build-runner|quality-gate-runner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-snapshot.py\"",
            "timeout": 30,
            "statusMessage": "subagent-snapshot (return format)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-docs-lint.py",
            "timeout": 60,
            "statusMessage": "docs-lint (edited document)"
          }
        ]
      }
    ]
  }
}
