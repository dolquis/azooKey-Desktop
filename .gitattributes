# 評価データは eol=lf を強制（eval_dataset_sha256 の安定性のため。
# docs/conversion-quality-benchmark-spec.md §14.1）。
bench/data/**.jsonl text eol=lf
bench/data/PROVENANCE.json text eol=lf

# Shell scripts must stay LF so they run in the Linux cloud sandbox
# (Claude Code on the web). See docs/handoff/claude-code-web-setup.md.
*.sh text eol=lf

# Serena rewrites its shared YAML configuration; keep round trips stable.
.serena/*.yml text eol=lf
