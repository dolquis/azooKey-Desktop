{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AZOOKEY_BUILD_TESTS": "ON",
        "AZOOKEY_BUILD_BENCH": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clangd",
      "displayName": "Windows clangd Compilation Database",
      "description": "Configure-only clang-cl DB for .clangd/Serena. TRY_COMPILE as STATIC_LIBRARY skips the link step so a linker is not required.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "AZOOKEY_BUILD_TESTS": "OFF",
        "AZOOKEY_BUILD_BENCH": "OFF",
        "AZOOKEY_USE_COMPILER_CACHE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-llama-debug",
      "displayName": "Windows llama.cpp Debug",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build/windows-llama-debug",
      "cacheVariables": {
        "AZOOKEY_FETCH_LLAMA_CPP": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AZOOKEY_BUILD_TESTS": "ON",
        "AZOOKEY_BUILD_BENCH": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AZOOKEY_BUILD_TESTS": "ON",
        "AZOOKEY_BUILD_BENCH": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows AddressSanitizer",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "cacheVariables": {
        "AZOOKEY_BUILD_BENCH": "OFF",
        "AZOOKEY_BUILD_TSF_TIP": "OFF",
        "AZOOKEY_ENABLE_ASAN": "ON",
        "AZOOKEY_USE_COMPILER_CACHE": "OFF"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-asan-ubsan",
      "cacheVariables": {
        "AZOOKEY_BUILD_BENCH": "OFF",
        "AZOOKEY_ENABLE_ASAN": "ON",
        "AZOOKEY_ENABLE_UBSAN": "ON",
        "AZOOKEY_USE_COMPILER_CACHE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-llama-debug",
      "configurePreset": "windows-llama-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan"
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-llama-debug",
      "configurePreset": "windows-llama-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
