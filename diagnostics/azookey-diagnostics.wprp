<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder
  Version="1.0"
  Author="azooKey Project"
  Copyright="azooKey Project"
  Company="azooKey Project">
  <Profiles>
    <SystemCollector
      Id="SystemCollector_AzooKeyDiagnostics"
      Name="azooKey Diagnostics">
      <BufferSize Value="1024" />
      <Buffers Value="20" />
    </SystemCollector>
    <EventCollector Id="EventCollector_AzooKey" Name="azooKey ETW">
      <BufferSize Value="64" />
      <Buffers Value="16" />
    </EventCollector>

    <SystemProvider Id="SystemProvider_AzooKeyDiagnostics">
      <Keywords>
        <Keyword Value="CSwitch" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="Loader" />
        <Keyword Value="NetworkTrace" />
        <Keyword Value="ProcessThread" />
        <Keyword Value="Registry" />
      </Keywords>
    </SystemProvider>
    <EventProvider Id="EventProvider_AzooKey" Name="89553f1c-7d18-4a6d-a720-534921c8b730" Level="5" />

    <Profile
      Id="AzooKeyDiagnostics.Verbose.File"
      Name="AzooKeyDiagnostics"
      Description="Process, file, registry, and network events for azooKey TIP and inference-host diagnostics."
      LoggingMode="File"
      DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_AzooKeyDiagnostics">
          <SystemProviderId Value="SystemProvider_AzooKeyDiagnostics" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_AzooKey">
          <EventProviders>
            <EventProviderId Value="EventProvider_AzooKey" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>

    <Profile
      Id="AzooKeyDiagnostics.Light.File"
      Name="AzooKeyDiagnostics"
      Description="Lightweight process, file, registry, and network events for azooKey diagnostics."
      Base="AzooKeyDiagnostics.Verbose.File"
      LoggingMode="File"
      DetailLevel="Light" />
    <Profile
      Id="AzooKeyDiagnostics.Verbose.Memory"
      Name="AzooKeyDiagnostics"
      Description="In-memory process, file, registry, and network events for azooKey diagnostics."
      Base="AzooKeyDiagnostics.Verbose.File"
      LoggingMode="Memory"
      DetailLevel="Verbose" />
    <Profile
      Id="AzooKeyDiagnostics.Light.Memory"
      Name="AzooKeyDiagnostics"
      Description="Lightweight in-memory process, file, registry, and network events for azooKey diagnostics."
      Base="AzooKeyDiagnostics.Verbose.File"
      LoggingMode="Memory"
      DetailLevel="Light" />
  </Profiles>
</WindowsPerformanceRecorder>
