<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="azooKey"
      Manufacturer="dolquis"
      Version="$(ProductVersion)"
      Language="1041"
      UpgradeCode="6A30BD56-AA6B-41E0-B786-26F9739303F4"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">
    <SummaryInformation Description="azooKey Windows Japanese input method" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
          Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (WINDOWSBUILDNUMBER &gt;= 18362)"
        Message="azooKey requires Windows 10 version 1903 (build 18362) or later." />
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of azooKey is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="azooKey">
        <Directory Id="RewriterDataFolder" Name="data">
          <Component Id="SymbolDataComponent" Guid="*">
            <File Id="SymbolDataFile" Source="$(RewriterDataDir)\symbol.tsv" KeyPath="yes" />
          </Component>
          <Component Id="EmojiDataComponent" Guid="*">
            <File Id="EmojiDataFile" Source="$(RewriterDataDir)\emoji.tsv" KeyPath="yes" />
          </Component>
        </Directory>
        <Component Id="TipComponent" Guid="85A678CC-4D73-4C41-B2CF-E0E458AB4AE0">
          <File
              Id="TipDll"
              Source="$(TipDllPath)"
              Name="azookey_tsf_tip.dll"
              KeyPath="yes" />
        </Component>

        <Component Id="HostComponent" Guid="086E7A58-AB71-4DEA-8F84-08B25B9A48B6">
          <File
              Id="HostExe"
              Source="$(HostExePath)"
              Name="azookey_inference_host.exe"
              KeyPath="yes" />
        </Component>

        <Component Id="VCRuntimeComponent" Guid="A6B28239-BB59-4013-9BCA-6FE5E35B4A57">
          <File Id="Msvcp140Dll" Source="$(VCRuntimeDir)\msvcp140.dll" />
          <File Id="Vcruntime140Dll" Source="$(VCRuntimeDir)\vcruntime140.dll" />
          <File
              Id="Vcruntime140_1Dll"
              Source="$(VCRuntimeDir)\vcruntime140_1.dll"
              KeyPath="yes" />
        </Component>

        <Component Id="HostStartupLogComponent" Guid="*">
          <File Id="HostStartupLog" Source="$(HostScriptsDir)\host-startup-log.ps1" KeyPath="yes" />
        </Component>
        <Component Id="HostSupervisorComponent" Guid="*">
          <File Id="HostSupervisor" Source="$(HostScriptsDir)\host-supervisor.ps1" KeyPath="yes" />
        </Component>
        <Component Id="InstalledHostWaiterComponent" Guid="*">
          <File Id="InstalledHostWaiter" Source="$(HostScriptsDir)\wait-installed-host.ps1" KeyPath="yes" />
        </Component>
        <Component Id="HostStartupComponent" Guid="7635B6C2-6707-4C25-9276-F1B99B953E20" Bitness="always64">
          <File Id="InstalledHostLauncher" Source="$(HostScriptsDir)\start-installed-host.ps1" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\azooKey\HostStartup"
              Name="InstallDirectory" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
              Name="azooKeyHost" Type="string"
              Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#InstalledHostLauncher]&quot;" />
        </Component>

        <Component Id="LicenseComponent" Guid="ADA29AB6-2AFF-4C87-827F-9C154498BBEE">
          <File
              Id="LicenseFile"
              Source="$(LicensePath)"
              Name="LICENSE.txt"
              KeyPath="yes" />
        </Component>

        <Component Id="ThirdPartyLicensesComponent" Guid="493F6E91-8201-471D-86BE-F32F17B86D3D">
          <File
              Id="ThirdPartyLicensesFile"
              Source="$(ThirdPartyLicensesPath)"
              Name="THIRD_PARTY_LICENSES.txt"
              KeyPath="yes" />
        </Component>

        <Component Id="SettingsComponent" Guid="4FF5479D-974F-4888-84F8-DA16C599F44D">
          <File
              Id="SettingsExe"
              Source="$(SettingsExePath)"
              Name="azookey_settings.exe"
              KeyPath="yes">
            <Shortcut
                Id="SettingsShortcut"
                Directory="ProgramMenuFolder"
                Name="azooKey Settings"
                Description="Configure azooKey"
                Advertise="yes"
                WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Retain files-in-use detection without racing supervisor restarts. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Feature Id="MainFeature" Title="azooKey" Level="1">
      <ComponentRef Id="HostStartupLogComponent" />
      <ComponentRef Id="TipComponent" />
      <ComponentRef Id="HostComponent" />
      <ComponentRef Id="HostSupervisorComponent" />
      <ComponentRef Id="InstalledHostWaiterComponent" />
      <ComponentRef Id="HostStartupComponent" />
      <ComponentRef Id="SymbolDataComponent" />
      <ComponentRef Id="EmojiDataComponent" />
      <ComponentRef Id="VCRuntimeComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="ThirdPartyLicensesComponent" />
      <ComponentRef Id="SettingsComponent" />
      <Files Include="$(SettingsPayloadDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(SettingsExePath)" />
        <?ifdef SettingsObjDirExists ?>
        <Exclude Files="$(SettingsPayloadDir)\obj\**" />
        <?endif ?>
        <Exclude Files="$(SettingsPayloadDir)\*.exp" />
        <Exclude Files="$(SettingsPayloadDir)\*.lib" />
        <Exclude Files="$(SettingsPayloadDir)\*.pdb" />
        <Exclude Files="$(SettingsPayloadDir)\*.ilk" />
      </Files>
    </Feature>

    <!--
      DllRegisterServer also registers the TSF profile and categories, which
      cannot be represented completely by MSI registry tables. Use the
      installed DLL path so the COM InprocServer32 value never points at a
      temporary custom-action extraction directory.
    -->
    <CustomAction
        Id="RegisterTip"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[System64Folder]msiexec.exe&quot; /y &quot;[#TipDll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction
        Id="RegisterTipOnUninstallRollback"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[System64Folder]msiexec.exe&quot; /y &quot;[#TipDll]&quot;"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="UnregisterTip"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[System64Folder]msiexec.exe&quot; /z &quot;[#TipDll]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction
        Id="UnregisterTipOnInstallRollback"
        Directory="INSTALLFOLDER"
        ExeCommand="&quot;[System64Folder]msiexec.exe&quot; /z &quot;[#TipDll]&quot;"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />

    <CustomAction Id="WaitForInstalledHost" Directory="INSTALLFOLDER"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#InstalledHostWaiter]&quot;"
        Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="WaitForInstalledHost" Before="RemoveFiles"
          Condition="$HostStartupComponent = 2" />
      <Custom
          Action="RegisterTipOnUninstallRollback"
          Before="UnregisterTip"
          Condition="$TipComponent = 2" />
      <Custom
          Action="UnregisterTip"
          Before="RemoveFiles"
          Condition="$TipComponent = 2" />
      <Custom
          Action="UnregisterTipOnInstallRollback"
          After="InstallFiles"
          Condition="$TipComponent = 3" />
      <Custom
          Action="RegisterTip"
          After="UnregisterTipOnInstallRollback"
          Condition="$TipComponent = 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
