<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <!--
      WiX 7 fails with WIX7015 until the OSMF EULA is accepted. The terms and the
      fee condition are recorded in docs/licensing-policy.md.
    -->
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <TipDllPath Condition="'$(TipDllPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-release\tsf-tip\azookey_tsf_tip.dll</TipDllPath>
    <HostExePath Condition="'$(HostExePath)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-release\inference-host\azookey_inference_host.exe</HostExePath>
    <SettingsPayloadDir Condition="'$(SettingsPayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-release\settings-app\Release</SettingsPayloadDir>
    <SettingsExePath Condition="'$(SettingsExePath)' == ''">$(SettingsPayloadDir)\azookey_settings.exe</SettingsExePath>
    <SettingsIconPath Condition="'$(SettingsIconPath)' == ''">$(MSBuildThisFileDirectory)..\..\settings-app\Assets\azookey-settings.ico</SettingsIconPath>
    <VCRuntimeDir Condition="'$(VCRuntimeDir)' == ''">__NOT_PROVIDED__</VCRuntimeDir>
    <VCOpenMPDir Condition="'$(VCOpenMPDir)' == ''">__NOT_PROVIDED__</VCOpenMPDir>
    <LicensePath Condition="'$(LicensePath)' == ''">$(MSBuildThisFileDirectory)..\..\LICENSE</LicensePath>
    <ThirdPartyLicensesPath Condition="'$(ThirdPartyLicensesPath)' == ''">$(MSBuildThisFileDirectory)..\..\THIRD_PARTY_LICENSES</ThirdPartyLicensesPath>
    <RewriterDataDir Condition="'$(RewriterDataDir)' == ''">$(MSBuildThisFileDirectory)..\..\data</RewriterDataDir>
    <BundledDictionaryDir Condition="'$(BundledDictionaryDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\bundled-dictionaries</BundledDictionaryDir>
    <HostScriptsDir>$(MSBuildThisFileDirectory)..\..\scripts</HostScriptsDir>
    <OutputName>azooKey-$(ProductVersion)-x64</OutputName>
    <!--
      Windows App SDK multilingual binaries exceed the MSI File.Language limits.
      WiX applies ICE suppression at project validation scope, so keep the allowlist
      limited to ICE03 and mirror the exact value in the consistency test.
    -->
    <SuppressIces>ICE03</SuppressIces>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      TipDllPath=$(TipDllPath);
      HostExePath=$(HostExePath);
      SettingsPayloadDir=$(SettingsPayloadDir);
      SettingsExePath=$(SettingsExePath);
      SettingsIconPath=$(SettingsIconPath);
      VCRuntimeDir=$(VCRuntimeDir);
      VCOpenMPDir=$(VCOpenMPDir);
      LicensePath=$(LicensePath);
      ThirdPartyLicensesPath=$(ThirdPartyLicensesPath);
      RewriterDataDir=$(RewriterDataDir);
      BundledDictionaryDir=$(BundledDictionaryDir);
      HostScriptsDir=$(HostScriptsDir)
    </DefineConstants>
  </PropertyGroup>

  <!-- WiX fails with WIX8601 unless the directory prefix of an exclusion exists. -->
  <PropertyGroup Condition="Exists('$(SettingsPayloadDir)\obj')">
    <DefineConstants>$(DefineConstants);SettingsObjDirExists=1</DefineConstants>
  </PropertyGroup>

  <!-- MSBuild property functions cannot call FileVersionInfo. -->
  <UsingTask
      TaskName="ReadAzooKeyFileVersion"
      TaskFactory="RoslynCodeTaskFactory"
      AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <FileVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        FileVersion = System.Diagnostics.FileVersionInfo.GetVersionInfo(FilePath).FileVersion ?? string.Empty;
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateAzooKeyPayload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(SettingsIconPath)')" Text="Settings icon not found: $(SettingsIconPath)" />
    <Error Condition="!Exists('$(HostScriptsDir)\host-startup-log.ps1')" Text="Host startup logger missing" />
    <Error Condition="!Exists('$(HostScriptsDir)\host-supervisor.ps1')" Text="Host supervisor missing" />
    <Error Condition="!Exists('$(HostScriptsDir)\start-installed-host.ps1')" Text="Installed host launcher missing" />
    <Error Condition="!Exists('$(HostScriptsDir)\wait-installed-host.ps1')" Text="Installed host shutdown waiter missing" />
    <Error Condition="!Exists('$(TipDllPath)')" Text="TIP DLL not found: $(TipDllPath)" />
    <Error Condition="!Exists('$(HostExePath)')" Text="Inference host not found: $(HostExePath)" />
    <Error Condition="!Exists('$(SettingsPayloadDir)')" Text="Settings payload directory not found: $(SettingsPayloadDir)" />
    <Error Condition="!Exists('$(SettingsExePath)')" Text="Settings executable not found: $(SettingsExePath)" />
    <Error Condition="!Exists('$(VCRuntimeDir)\msvcp140.dll')" Text="MSVC runtime not found: $(VCRuntimeDir)\msvcp140.dll. Set VCRuntimeDir to the x64 Microsoft.VC*.CRT directory." />
    <Error Condition="!Exists('$(VCRuntimeDir)\vcruntime140.dll')" Text="MSVC runtime not found: $(VCRuntimeDir)\vcruntime140.dll. Set VCRuntimeDir to the x64 Microsoft.VC*.CRT directory." />
    <Error Condition="!Exists('$(VCRuntimeDir)\vcruntime140_1.dll')" Text="MSVC runtime not found: $(VCRuntimeDir)\vcruntime140_1.dll. Set VCRuntimeDir to the x64 Microsoft.VC*.CRT directory." />
    <Error Condition="!Exists('$(VCOpenMPDir)\vcomp140.dll')" Text="MSVC runtime not found: $(VCOpenMPDir)\vcomp140.dll. Set VCOpenMPDir to the x64 Microsoft.VC*.OpenMP directory." />
    <Error Condition="!Exists('$(LicensePath)')" Text="License file not found: $(LicensePath)" />
    <Error Condition="!Exists('$(ThirdPartyLicensesPath)')" Text="Third-party licenses file not found: $(ThirdPartyLicensesPath)" />
    <Error Condition="!Exists('$(RewriterDataDir)\symbol.tsv')" Text="Symbol data not found" />
    <Error Condition="!Exists('$(RewriterDataDir)\emoji.tsv')" Text="Emoji data not found" />
    <Error Condition="!Exists('$(BundledDictionaryDir)\dict\sudachi_lexicon.azdic')" Text="Bundled dictionary not found: $(BundledDictionaryDir)\dict\sudachi_lexicon.azdic. Run dictbuild/build_bundled.py." />
    <Error Condition="!Exists('$(BundledDictionaryDir)\ThirdPartyNotices.txt')" Text="Bundled dictionary notices not found: $(BundledDictionaryDir)\ThirdPartyNotices.txt" />
  </Target>

  <!--
    SettingsExe is a versioned KeyPath in a component shared across major
    upgrades. If an installed product has a higher FileVersion, costing
    disallows the component before RemoveExistingProducts deletes the old
    file, so the upgrade leaves no azookey_settings.exe (DEV-1488).
    Run before CoreCompile so a mismatch fails before WiX writes the MSI.
  -->
  <Target Name="ValidateAzooKeySettingsVersion" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(SettingsExePath)')" Text="Settings executable not found: $(SettingsExePath)" />
    <ReadAzooKeyFileVersion FilePath="$(SettingsExePath)">
      <Output TaskParameter="FileVersion" PropertyName="AzooKeySettingsFileVersion" />
    </ReadAzooKeyFileVersion>
    <Error Condition="'$(AzooKeySettingsFileVersion)' != '$(ProductVersion).0'" Text="Settings executable FileVersion '$(AzooKeySettingsFileVersion)' does not match MSI ProductVersion '$(ProductVersion).0': $(SettingsExePath). Build azookey_settings with -DAZOOKEY_PRODUCT_VERSION=$(ProductVersion)." />
  </Target>
</Project>
