<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Compared with the official C++/WinRT template (also used for unpackaged apps):
       https://github.com/microsoft/WindowsAppSDK/blob/6b178e79e59d28efb10ef5c8c68b051d2615c3e6/dev/Templates/Source/ProjectTemplates/Desktop/CppWinRT/PackagedApp/BlankApp/app.manifest
       Intentional differences: product identity below, and the existing legacy DPI
       fallbacks retained alongside PerMonitorV2. Packaging remains None in vcxproj.
       Assembly identity stays stable; release versions belong to VERSIONINFO. -->
  <assemblyIdentity version="1.0.0.0" name="azookey_settings.app" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
