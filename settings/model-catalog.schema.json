{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azookey.local/schemas/model-catalog.schema.json",
  "title": "azooKey Zenzai model catalog",
  "description": "Version 1 is the DEV-438 declarative GGUF catalog. Version 2 (DEV-1770, DEV-1789) places each engine's artifact under artifacts and can name the upstream source of the GGUF.",
  "oneOf": [
    { "$ref": "#/$defs/catalogV1" },
    { "$ref": "#/$defs/catalogV2" }
  ],
  "$defs": {
    "catalogV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "models"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "defaultModelId": {
          "$ref": "#/$defs/modelId",
          "description": "Optional default model id. If omitted, the host resolver uses the first entry in models."
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modelV1"
          }
        }
      }
    },
    "catalogV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "models"],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "defaultModelId": {
          "$ref": "#/$defs/modelId",
          "description": "Optional default model id. If omitted, the host resolver uses the first entry in models."
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modelV2"
          }
        }
      }
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "modelFileName": {
      "type": "string",
      "pattern": "^(?!\\.\\.?$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9]) *(?:\\.|$))[\\u0020-\\u002E\\u0030-\\u0039\\u003B-\\u005B\\u005D-\\u007E]+\\.[Gg][Gg][Uu][Ff]$",
      "description": "A GGUF file name only, in printable ASCII. Absolute paths, subdirectories, drive prefixes, control and non-ASCII characters, traversal segments, and Windows reserved device names (CON, PRN, AUX, NUL, CONIN$, CONOUT$, COM0-9, LPT0-9, with any extension and in any case) are not allowed."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "promptFormat": {
      "type": "string",
      "default": "zenz-v3",
      "enum": ["zenz-v3", "kanakanji-edge-v1"],
      "description": "Prompt format of the model (docs/zenzai-inference-spec.md section 2.4.2). An entry without the key is zenz-v3."
    },
    "modelV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fileName", "sha256"],
      "properties": {
        "id": {
          "$ref": "#/$defs/modelId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "fileName": {
          "$ref": "#/$defs/modelFileName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backendHint": {
          "type": "string",
          "default": "llama.cpp",
          "enum": ["llama.cpp"]
        },
        "promptFormat": {
          "$ref": "#/$defs/promptFormat"
        }
      }
    },
    "modelV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifacts"],
      "properties": {
        "id": {
          "$ref": "#/$defs/modelId"
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "promptFormat": {
          "$ref": "#/$defs/promptFormat"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["llama.cpp"],
          "description": "Artifacts by engine. The R2 key (onnxruntime-genai) is not defined until DEV-1768 settles its contents.",
          "properties": {
            "llama.cpp": {
              "$ref": "#/$defs/llamaCppArtifact"
            }
          }
        }
      }
    },
    "llamaCppArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "dependentRequired": {
        "source": ["sizeBytes"]
      },
      "properties": {
        "fileName": {
          "$ref": "#/$defs/modelFileName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296,
          "description": "Exact size in bytes, at most 4 GiB (the product's fixed limit). The download limit; a fetched file must also match sha256."
        },
        "source": {
          "$ref": "#/$defs/huggingFaceSource"
        }
      }
    },
    "huggingFaceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["huggingFaceRepo", "revision"],
      "description": "Upstream Hugging Face location. The URL is https://huggingface.co/<huggingFaceRepo>/resolve/<revision>/<fileName>; a catalog cannot name any other host (docs/sideload-packaging-spec.md section 1.6.2: no rehosting).",
      "properties": {
        "huggingFaceRepo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "not": { "pattern": "\\.\\." }
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full commit id. A branch or tag name is not allowed, so the artifact cannot change under the pin."
        }
      }
    }
  }
}
